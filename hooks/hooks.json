{
  "$comment": "Plugin hook registration. Unlike hooks wired in a project's .claude/settings.json (which do NOT fire in Cowork), plugin hooks run in BOTH Claude Code and Cowork. Commands use ${CLAUDE_PLUGIN_ROOT}. All four hooks are Python-stdlib (no venv).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/nothing_loose.py" }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/env_protect.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/doc_hygiene.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/stop_reminder.py" }
        ]
      }
    ]
  }
}
